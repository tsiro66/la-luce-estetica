# Copy to .dev.vars and fill in. Never commit the real .dev.vars.
# These are the Cloudflare Pages Function bindings for functions/api/contact.ts
# (same names as before — previously .env for the Workers/Astro action).

# Resend API key (secret; also set in the Pages dashboard for Production + Preview) — https://resend.com/api-keys
RESEND_API_KEY=""

# Where enquiry emails are delivered. Defaults to site.footer.email.
EMAIL_TO=""

# Verified sender — https://resend.com/domains
# Falls back to "La Luce Estetica <site.footer.email>".
# Until the business domain is verified at Resend this must stay onboarding@resend.dev.
EMAIL_FROM="La Luce Estetica <onboarding@resend.dev>"
