# Copy to .env and fill in. Never commit the real .env.
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=""

# Where enquiry emails are delivered. Defaults to site.footer.email.
EMAIL_TO=""

# Verified sender — https://resend.com/domains
# Falls back to "La Luce Estetica <site.footer.email>".
EMAIL_FROM="La Luce Estetica <hello@yourdomain>"
