---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  headerTheme?: "overlay" | "solid";
}

const {
  title = site.seo.defaultTitle,
  description = site.seo.defaultDescription,
  headerTheme = "solid",
} = Astro.props;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url.pathname === "/" ? Astro.site : new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
    {Astro.url.pathname === "/" && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "HealthAndBeautyBusiness",
          name: "La Luce Estetica & Skin Clinic",
          description: site.seo.defaultDescription,
          url: Astro.site?.toString(),
          telephone: "+30 21 6070 1989",
          email: site.footer.email,
          address: {
            "@type": "PostalAddress",
            streetAddress: site.footer.address.street,
            addressLocality: "Χαλάνδρι",
            postalCode: "152 34",
            addressRegion: "Αττική",
            addressCountry: "GR",
          },
          geo: { "@type": "GeoCoordinates", latitude: 38.0250, longitude: 23.7980 },
          openingHoursSpecification: [
            { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "10:00", closes: "21:00" },
            { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "18:00" },
          ],
          sameAs: [site.treatwellUrl],
        })}
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+Display:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Commissioner:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#content" class="skip-link">Μετάβαση στο περιεχόμενο</a>
    <Header theme={headerTheme} />
    <main id="content" class:list={[{ "pt-28": headerTheme === "solid" }]}>
      <slot />
    </main>
    <Footer />

    <script>
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );
      document
        .querySelectorAll("[data-reveal]")
        .forEach((el) => revealObserver.observe(el));
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 60;
        transform: translateY(-300%);
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.5rem 1rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        transition: transform 0.2s ease;
      }

      .skip-link:focus-visible {
        transform: none;
      }
    </style>
  </body>
</html>
