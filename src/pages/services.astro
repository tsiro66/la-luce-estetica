---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import pages from "../data/pages.json";
import categories from "../data/categories.json";

const treatments = await getCollection("treatments");

const pad = (n: number) => String(n).padStart(2, "0");

export const prerender = true;
---

<Layout
  title={`${pages.services.title} — ${site.siteName}`}
  description={site.seo.defaultDescription}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-8 lg:px-8">
    <p class="eyebrow" data-reveal>La Luce Estetica & Skin Clinic</p>
    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-light leading-[1.02] text-ink sm:text-6xl"
      data-reveal
      style="--reveal-delay:120ms"
    >
      Υπηρεσίες <em class="italic text-champagne">θεραπειών</em>
    </h1>
    <p
      class="mt-6 max-w-xl font-sans text-base leading-relaxed text-ink/70"
      data-reveal
      style="--reveal-delay:220ms"
    >
      Επιλέξτε κατηγορία για να δείτε τις θεραπείες.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-28 lg:px-8">
    <div class="border-b border-ink/15">
      {
        categories.categories.map((cat, i) => (
          <a
            href={`/services/${cat.slug}`}
            class="group flex items-baseline justify-between gap-4 border-t border-ink/15 py-8 transition-colors duration-300 hover:bg-blush sm:py-10"
          >
            <span class="flex items-baseline gap-6 sm:gap-10">
              <span class="font-sans text-xs tabular-nums text-champagne">
                {pad(i + 1)}
              </span>
              <span class="font-display text-3xl font-light text-ink transition-transform duration-500 ease-out group-hover:translate-x-2 sm:text-5xl">
                {cat.name}
              </span>
            </span>
            <span class="flex items-baseline gap-6 sm:gap-10">
              <span class="font-sans text-xs uppercase tracking-[0.22em] text-ink/40 tabular-nums">
                {pad(treatments.filter((t) => t.data.category === cat.name).length)}
              </span>
              <span
                class="text-champagne opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                &nearr;
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
