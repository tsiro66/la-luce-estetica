---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import site from "../../data/site.json";
import servicesMenu from "../../data/services-menu.json";

export async function getStaticPaths() {
  const treatments = await getCollection("treatments");
  return treatments.map((treatment) => ({
    params: { slug: treatment.id },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;
const { data, body } = treatment;

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/site/*.jpg",
  { eager: true },
);
const treatmentImage = data.image
  ? siteImages[`../../assets/site/${data.image}`]?.default
  : undefined;

const other = (await getCollection("treatments"))
  .filter((t) => t.id !== treatment.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const infoItems = [
  { label: "Διάρκεια", value: data.duration },
  { label: "Διάρκεια αποτελέσματος", value: data.info?.resultDuration },
  { label: "Επίπεδο πόνου", value: data.info?.pain },
  { label: "Αποθεραπεία", value: data.info?.recovery },
].filter((item) => Boolean(item.value));

const introHtml = marked.parse(body ?? "");

export const prerender = true;
---

<Layout
  title={data.pageTitle ?? `${data.title} — ${site.siteName}`}
  description={data.subtitle ?? site.seo.defaultDescription}
>
  <article class="mx-auto max-w-7xl px-6 pt-24 pb-16 lg:px-8">
    <a
      href="/services"
      class="inline-flex items-center gap-2 font-sans text-[0.7rem] font-medium uppercase tracking-[0.24em] text-ink/50 transition-colors hover:text-champagne"
    >
      <span aria-hidden="true">&larr;</span> Όλες οι υπηρεσίες
    </a>

    <header class="mt-10 max-w-3xl">
      <p class="eyebrow" data-reveal>{data.category}</p>
      <h1
        class="mt-4 font-display text-4xl font-light leading-[1.05] text-ink sm:text-6xl"
        data-reveal
        style="--reveal-delay:120ms"
      >
        {data.title}
      </h1>
      {
        data.subtitle && (
          <p
            class="mt-6 font-display text-xl font-light italic leading-relaxed text-ink/70 sm:text-2xl"
            data-reveal
            style="--reveal-delay:220ms"
          >
            {data.subtitle}
          </p>
        )
      }
    </header>

    {
      treatmentImage && (
        <div class="relative mt-14 border border-sand bg-cream" data-reveal>
          <Image
            src={treatmentImage}
            alt={data.title}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1280px) 1280px, 100vw"
            quality={80}
            loading="eager"
            class="h-[min(70vh,640px)] w-full object-cover"
          />
        </div>
      )
    }

    <div class="mt-16 grid gap-16 md:grid-cols-12">
      <div class="md:col-span-7">
        {
          body && (
            <div
              class="max-w-prose space-y-4 font-sans text-[0.95rem] leading-relaxed text-ink/75 [&_strong]:font-semibold [&_strong]:text-ink"
              set:html={introHtml}
              data-reveal
            />
          )
        }

        {
          data.problems.length > 0 && (
            <section class="mt-14" data-reveal>
              <h2 class="eyebrow">Ποιο πρόβλημα λύνει</h2>
              <ul class="mt-6 space-y-4 border-b border-ink/15 pb-8">
                {data.problems.map((problem) => (
                  <li class="flex gap-4 font-sans text-[0.95rem] leading-relaxed text-ink/75">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-champagne" aria-hidden="true" />
                    {problem}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.benefits.length > 0 && (
            <section class="mt-14" data-reveal>
              <h2 class="eyebrow">Οφέλη & Πλεονεκτήματα</h2>
              <ul class="mt-6 space-y-4 border-b border-ink/15 pb-8">
                {data.benefits.map((benefit) => (
                  <li class="flex gap-4 font-sans text-[0.95rem] leading-relaxed text-ink/75">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-champagne" aria-hidden="true" />
                    {benefit}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (data.before.length > 0 || data.after.length > 0) && (
            <section class="mt-14 grid gap-10 sm:grid-cols-2" data-reveal>
              <div>
                <h2 class="eyebrow">Πριν τη συνεδρία</h2>
                <ol class="mt-6 space-y-4">
                  {data.before.map((step, i) => (
                    <li class="flex gap-4 border-t border-ink/10 pt-3 font-sans text-sm leading-relaxed text-ink/75">
                      <span class="font-sans text-xs tabular-nums text-champagne">{String(i + 1).padStart(2, "0")}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
              <div>
                <h2 class="eyebrow">Μετά τη συνεδρία</h2>
                <ol class="mt-6 space-y-4">
                  {data.after.map((step, i) => (
                    <li class="flex gap-4 border-t border-ink/10 pt-3 font-sans text-sm leading-relaxed text-ink/75">
                      <span class="font-sans text-xs tabular-nums text-champagne">{String(i + 1).padStart(2, "0")}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          )
        }

        {
          treatment.id === "laser-alexandrite" && (
            <section class="mt-14" data-reveal>
              <h2 class="eyebrow">Περιοχές Laser — ανά συνεδρία</h2>
              <ul class="mt-6 grid gap-x-10 gap-y-4 sm:grid-cols-2">
                {servicesMenu.laser.map((area) => (
                  <li class="flex items-baseline justify-between gap-4 border-t border-ink/10 pt-3">
                    <span class="font-sans text-sm text-ink">{area.name}</span>
                    <span class="font-sans text-xs tabular-nums text-ink/50">{area.duration}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          treatment.id === "waxing" && (
            <section class="mt-14" data-reveal>
              <h2 class="eyebrow">Περιοχές με Κερί</h2>
              <ul class="mt-6 space-y-3">
                {servicesMenu.wax.map((area) => (
                  <li class="flex items-baseline justify-between gap-4 border-t border-ink/10 pt-3">
                    <span class="font-sans text-sm text-ink">{area.name}</span>
                    <span class="font-sans text-xs tabular-nums text-ink/50">{area.duration}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.faq.length > 0 && (
            <section class="mt-14" data-reveal>
              <h2 class="eyebrow">Συχνές ερωτήσεις & μύθοι</h2>
              <div class="mt-6 border-b border-ink/15">
                {data.faq.map((item) => (
                  <details class="group border-t border-ink/15 py-5 [&:open]:pb-6">
                    <summary class="cursor-pointer list-none font-sans text-[0.95rem] font-medium text-ink marker:hidden [&::-webkit-details-marker]:hidden">
                      <span class="mr-3 text-champagne" aria-hidden="true">+</span>
                      {item.q}
                    </summary>
                    <p class="mt-3 pl-7 font-sans text-sm leading-relaxed text-ink/70">
                      {item.a}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="md:col-span-5">
        <div
          class="sticky top-32 border border-ink/15 bg-blush p-8"
          data-reveal
          style="--reveal-delay:200ms"
        >
          <h2 class="font-display text-2xl font-light text-ink">
            Γενικές πληροφορίες
          </h2>
          <dl class="mt-6 space-y-4">
            {
              infoItems.map((item) => (
                <div class="flex items-baseline justify-between gap-6 border-t border-ink/10 pt-3">
                  <dt class="font-sans text-[0.65rem] font-medium uppercase tracking-[0.2em] text-ink/50">
                    {item.label}
                  </dt>
                  <dd class="font-sans text-sm font-medium text-ink">{item.value}</dd>
                </div>
              ))
            }
          </dl>
          <a
            href={site.treatwellUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 flex w-full items-center justify-center gap-3 bg-ink px-6 py-4 font-sans text-[0.7rem] font-medium uppercase tracking-[0.24em] text-paper transition-colors hover:bg-champagne"
          >
            Κλείστε Ραντεβού Τώρα <span aria-hidden="true">&nearr;</span>
          </a>
          <p class="mt-4 text-center font-sans text-xs text-ink/50">
            Η κράτηση γίνεται μέσω Treatwell
          </p>
        </div>
      </aside>
    </div>
  </article>

  <section class="border-t border-ink/10 bg-blush">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <p class="eyebrow" data-reveal>Συνεχίστε την περιήγηση</p>
      <div class="mt-8 border-b border-ink/15">
        {
          other.map((t) => (
            <a
              href={`/services/${t.id}`}
              class="group flex items-baseline justify-between gap-4 border-t border-ink/15 py-5 transition-colors hover:bg-blush"
            >
              <span class="font-display text-xl font-light text-ink transition-transform duration-500 ease-out group-hover:translate-x-2">
                {t.data.title}
              </span>
              <span class="font-sans text-xs uppercase tracking-[0.2em] text-ink/40">
                {t.data.duration}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
