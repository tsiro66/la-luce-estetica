---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;
---
<Layout title="Μασάζ — Υπηρεσίες">
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-8 lg:px-8">
    <p class="eyebrow" data-reveal>Υπηρεσίες</p>
    <h1 class="mt-4 font-display text-5xl font-light leading-[1.02] text-ink sm:text-6xl" data-reveal style="--reveal-delay:120ms">
      Μασάζ
    </h1>
    <p class="mt-8 font-sans text-base text-ink/60" data-reveal style="--reveal-delay:220ms">
      Το περιεχόμενο της κατηγορίας ετοιμάζεται.
    </p>
  </section>
</Layout>
