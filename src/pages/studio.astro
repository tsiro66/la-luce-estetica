---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import pages from "../data/pages.json";

import receptionRoom from "../assets/site/reception.jpg";
import facialRoom from "../assets/site/room-facial.jpg";
import facialRoom2 from "../assets/site/room-facial-2.jpg";
import couplesRoom from "../assets/site/room-couples.jpg";
import bodyRoom from "../assets/site/room-body.jpg";
import machineDetail from "../assets/site/machine-detail.jpg";
import storefront from "../assets/site/storefront.jpg";
import storefrontStreet from "../assets/site/storefront-street.jpg";

import tourFacial from "../assets/tour/facial-room.jpg";
import tourBody from "../assets/tour/body-room.jpg";

const tourScenes = [
  { id: "facial", title: "Αίθουσα Προσώπου", src: tourFacial.src },
  { id: "body", title: "Αίθουσα Θεραπειών Σώματος", src: tourBody.src },
];

export const prerender = true;
---

<Layout
  title={`${pages.studio.title} — ${site.siteName}`}
  description="Γνωρίστε τον χώρο της La Luce Estetica & Skin Clinic στο Χαλάνδρι — αίθουσες θεραπειών, μηχανήματα τελευταίας τεχνολογίας και εικονική περιήγηση 360°."
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-8 lg:px-8">
    <p class="eyebrow" data-reveal>La Luce Estetica & Skin Clinic</p>
    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-light leading-[1.02] text-ink sm:text-6xl"
      data-reveal
      style="--reveal-delay:120ms"
    >
      Ο <em class="italic text-champagne">χώρος</em> μας
    </h1>
    <p
      class="mt-6 max-w-xl font-sans text-base leading-relaxed text-ink/70"
      data-reveal
      style="--reveal-delay:220ms"
    >
      Στο κέντρο του Χαλανδρίου, σχεδιασμένος για να σας κάνει να νιώσετε
      άνετα από την πρώτη στιγμή — καθαροί, ήσυχοι χώροι, κορυφαία
      μηχανήματα και λεπτομέρειες που φροντίζουν.
    </p>
  </section>

  <!-- Gallery -->
  <section class="mx-auto max-w-7xl px-6 pb-24 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={receptionRoom}
          alt="Υποδοχή με λογότυπο La Luce"
          widths={[640, 1024]}
          sizes="(min-width: 768px) 50vw, (min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={facialRoom}
          alt="Αίθουσα θεραπειών προσώπου"
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={couplesRoom}
          alt="Χώρος massage για δύο άτομα"
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={storefrontStreet}
          alt="Η La Luce Estetica στην οδό Πλατάνου"
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={facialRoom2}
          alt="Αίθουσα προσώπου με βάση προϊόντων"
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="aspect-[4/3]" data-reveal>
        <Image
          src={storefront}
          alt="Είσοδος La Luce Estetica επί της οδού Πλατάνου"
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          quality={80}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Virtual tour — pannellum is loaded on demand from the init script
       below, so it works under the ClientRouter on client-side navigations -->
  <section class="border-y border-ink/10 bg-blush" id="virtual-tour">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
      <p class="eyebrow" data-reveal>Εικονική περιήγηση 360°</p>
      <h2
        class="mt-4 font-display text-4xl font-light leading-[1.05] text-ink sm:text-5xl"
        data-reveal
        style="--reveal-delay:120ms"
      >
        Δείτε τον χώρο <em class="italic text-champagne">από μέσα</em>
      </h2>
      <p
        class="mt-6 max-w-xl font-sans text-base leading-relaxed text-ink/70"
        data-reveal
        style="--reveal-delay:220ms"
      >
        Επιλέξτε δωμάτιο, σύρετε με το ποντίκι για να κοιτάξετε γύρω σας.
      </p>

      <div class="relative mt-10" data-reveal style="--reveal-delay:300ms">
        <div
          id="tour-viewer"
          class="aspect-[16/9] w-full border border-sand bg-ink"
        >
        </div>
        <div
          id="tour-scenes"
          class="mt-4 flex flex-wrap gap-3"
          role="tablist"
          aria-label="Χώροι εικονικής περιήγησης"
        >
          {
            tourScenes.map((scene, i) => (
              <button
                type="button"
                data-scene={scene.id}
                class="tour-scene cursor-pointer border border-ink/20 bg-paper px-5 py-2.5 font-sans text-[0.7rem] font-medium uppercase tracking-[0.2em] text-ink transition-colors hover:border-champagne data-[active]:border-ink data-[active]:bg-ink data-[active]:text-paper"
                aria-selected={i === 0 ? "true" : "false"}
                data-active={i === 0 ? "" : undefined}
              >
                {scene.title}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Technology -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4" data-reveal>
        <p class="eyebrow">Η Τεχνολογία μας</p>
        <h2
          class="mt-4 font-display text-3xl font-light leading-[1.05] text-ink sm:text-4xl"
        >
          Μηχανήματα <em class="italic text-champagne">τελευταίας γενιάς</em>
        </h2>
        <p
          class="mt-6 font-sans text-base leading-relaxed text-ink/70"
        >
          Λειτουργούμε με πιστοποιημένα ιατροτεχνολογικά συστήματα — Laser
          Alexandrite Quanta Light A EVO, LPG Endermologie, Endospheres,
          HIEMS, Cavitation, RF και Pressotherapy — για ασφάλεια και
          αποτελεσματικότητα που τεκμηριώνεται.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 self-start md:col-span-8">
        <div class="aspect-[4/3]" data-reveal>
          <Image
            src={bodyRoom}
            alt="Αίθουσα θεραπειών σώματος με μηχανήματα"
            widths={[640, 1024]}
            sizes="(min-width: 1280px) 400px, 100vw"
            quality={80}
            class="h-full w-full object-cover"
          />
        </div>
        <div class="aspect-[4/3]" data-reveal>
          <Image
            src={machineDetail}
            alt="Σταθμός ελέγχου μηχανήματος θεραπειών"
            widths={[640, 1024]}
            sizes="(min-width: 1280px) 400px, 100vw"
            quality={80}
            class="h-full w-full object-cover object-[center_72%]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Hygiene -->
  <section class="border-t border-ink/10 bg-blush">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Υγιεινή & Πρότυπα</p>
        <h2 class="mt-4 font-display text-3xl font-light text-ink sm:text-4xl">
          Φροντίδα σε <em class="italic text-champagne">κάθε λεπτομέρεια</em>
        </h2>
        <p class="mt-6 font-sans text-base leading-relaxed text-ink/70">
          Πρωτόκολλα καθαρισμού και αποστείρωσης πριν και μετά από κάθε
          συνεδρία, μία σακούλα φροντίδας ανά πελάτη, καθαρά λευκά ειδών σε
          κάθε επίσκεψη και χώροι που αερίζονται συνεχώς. Τα προϊόντα μας
          επιλέγονται από επώνυμους, πιστοποιημένους οίκους.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t-2 border-champagne/40 bg-ink text-paper">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="flex flex-col items-start gap-6" data-reveal>
        <h2 class="font-display text-3xl font-light sm:text-4xl">
          Ελάτε να μας γνωρίσετε από κοντά
        </h2>
        <a
          href={site.treatwellUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-paper px-8 py-4 font-sans text-[0.7rem] font-medium uppercase tracking-[0.24em] text-ink transition-colors hover:bg-sand"
        >
          Κλείστε Ραντεβού <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ tourScenes }}>
  (function () {
    const PANNELLUM = "https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build";

    // The ClientRouter re-executes this inline script on every navigation
    // into /studio; everything here is idempotent / guarded.
    // The ClientRouter swaps the <head> on every client navigation, which
    // silently removes runtime-appended pannellum tags — while the
    // `pannellum` global from earlier executions survives. A missing
    // pannellum.css leaves the canvas styling-less, so it falls back to its
    // default attribute size (300x150-ish) and the renderer computes the
    // same tiny height back (clientHeight of an unstyled canvas = attr
    // height): the squashed-strip break. So: whether or not the global is
    // alive, first make sure both tags are back in the head (idempotent).
    function ensurePannellum(cb) {
      if (!document.querySelector("link[data-pannellum-css]")) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = PANNELLUM + "/pannellum.css";
        link.setAttribute("data-pannellum-css", "");
        document.head.append(link);
      }
      let script = document.querySelector(
        "script[data-pannellum-js]",
      );
      if (!script) {
        script = document.createElement("script");
        script.src = PANNELLUM + "/pannellum.js";
        script.setAttribute("data-pannellum-js", "");
        script.addEventListener(
          "error",
          () => {
            // Failed (offline / adblock) — drop the dead tag so the next
            // visit retries instead of finding a tag that will never load.
            script?.remove();
            const box = document.getElementById("tour-viewer");
            if (box && !box.querySelector("canvas")) {
              box.classList.add(
                "flex",
                "items-center",
                "justify-center",
                "p-6",
                "text-center",
                "font-sans",
                "text-sm",
                "text-paper/70",
              );
              box.textContent =
                "Δεν μπόρεσε να φορτώσει η εικονική περιήγηση. Δοκιμάστε ξανά σε λίγο.";
            }
          },
          { once: true },
        );
        document.head.append(script);
      }
      if (typeof pannellum !== "undefined") {
        // Cached/global survivor: no further load event will fire, so the
        // listener below would hang forever — call straight through.
        cb();
        return;
      }
      script.addEventListener("load", cb, { once: true });
    }

    function init() {
      const viewerEl = document.getElementById("tour-viewer");
      const buttons = document.querySelectorAll(".tour-scene");
      if (!viewerEl || viewerEl.dataset.tourInit) return;
      viewerEl.dataset.tourInit = "1";

      ensurePannellum(() => {
        // Element may have been swapped out while the CDN script loaded.
        if (!viewerEl.isConnected) return;

        const scenesConfig = {};
        tourScenes.forEach((scene) => {
          scenesConfig[scene.id] = {
            type: "equirectangular",
            panorama: scene.src,
            title: scene.title,
          };
        });

        const viewer = pannellum.viewer(viewerEl, {
          // NOTE: no top-level `type` here — pannellum's JS API merges
          // top-level keys over scene keys, so `type: "tour"` would
          // override every scene's "equirectangular". Tour mode is implied
          // by the presence of `scenes`.
          default: {
            firstScene: tourScenes[0].id,
            autoLoad: true,
            sceneFadeDuration: 600,
            mouseZoom: false,
            hfov: 120,
            maxHfov: 150,
          },
          scenes: scenesConfig,
        });
        window.__tourViewer = viewer;

        // Safety net: if the viewer was ever created before the container
        // reached its final size, pannellum only re-measures on window
        // resize events — an element size change alone won't fix the
        // canvas. Re-measure whenever the container itself resizes.
        const ro = new ResizeObserver(() => {
          if (window.__tourViewer === viewer) viewer.resize();
        });
        ro.observe(viewerEl);
        window.__tourRO = ro;

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            buttons.forEach((b) => {
              delete b.dataset.active;
              b.setAttribute("aria-selected", "false");
            });
            button.dataset.active = "";
            button.setAttribute("aria-selected", "true");
            viewer.loadScene(button.dataset.scene);
          });
        });
      });
    }

    // Destroy the pannellum viewer before leaving /studio, otherwise it
    // keeps rendering into detached DOM. Registered once, reads the live
    // instance from window (document-level listeners survive swaps).
    if (!window.__tourCleanupBound) {
      window.__tourCleanupBound = true;
      document.addEventListener("astro:before-swap", () => {
        window.__tourRO?.disconnect();
        window.__tourRO = null;
        window.__tourViewer?.destroy();
        window.__tourViewer = null;
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
