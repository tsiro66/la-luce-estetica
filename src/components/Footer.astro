---
import { NAV_LINKS, TREATWELL_URL } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-paper">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:py-20 md:grid-cols-12 lg:px-8"
  >
    <div class="md:col-span-5">
      <a href="/" class="font-display text-2xl tracking-wide text-ink">
        La Luce Estetica
      </a>
      <p class="mt-5 max-w-sm font-sans text-sm leading-relaxed text-ink/60">
        Short placeholder line about the studio — one or two sentences
        describing the clinic and its approach will go here.
      </p>
      <div class="mt-6 flex gap-6">
        <a href="#" class="footer-link">Instagram</a>
        <a href="#" class="footer-link">Facebook</a>
      </div>
    </div>

    <nav class="md:col-span-2" aria-label="Footer">
      <h3 class="footer-heading">Explore</h3>
      <ul class="mt-5 space-y-3">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-2">
      <h3 class="footer-heading">Visit</h3>
      <address
        class="mt-5 space-y-1 font-sans text-sm not-italic leading-relaxed text-ink/60"
      >
        Street Name 12<br />
        000 00 City<br />
        <a href="mailto:hello@example.com" class="footer-link">
          hello@example.com
        </a>
        <br />
        <a href="tel:+000000000000" class="footer-link">+00 000 000 0000</a>
      </address>
    </div>

    <div class="md:col-span-3">
      <h3 class="footer-heading">Hours</h3>
      <dl class="mt-5 space-y-2 font-sans text-sm text-ink/60">
        <div class="flex justify-between gap-6">
          <dt>Mon — Fri</dt>
          <dd class="tabular-nums">09:00 — 19:00</dd>
        </div>
        <div class="flex justify-between gap-6">
          <dt>Saturday</dt>
          <dd class="tabular-nums">10:00 — 16:00</dd>
        </div>
        <div class="flex justify-between gap-6">
          <dt>Sunday</dt>
          <dd>Closed</dd>
        </div>
      </dl>
      <a
        href={TREATWELL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 font-sans text-[0.65rem] font-medium uppercase tracking-[0.22em] text-ink underline decoration-sand underline-offset-8 transition-colors hover:decoration-champagne"
      >
        Book via Treatwell <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </div>

  <div class="border-t border-ink/10">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-6 py-6 font-sans text-[0.65rem] uppercase tracking-[0.2em] text-ink/40 sm:flex-row sm:items-center sm:justify-between lg:px-8"
    >
      <p>&copy; {year} La Luce Estetica</p>
      <p>Demo website — all content is placeholder</p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-champagne);
  }

  .footer-link {
    color: color-mix(in oklab, var(--color-ink) 60%, transparent);
    font-size: 0.875rem;
    transition: color 0.25s ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }
</style>
